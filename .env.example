# ============================================================================
# Икра & Рыба — переменные окружения сервера
# Скопируйте в .env и заполните. Файл .env в .gitignore, в репозиторий не попадёт.
# ============================================================================

NODE_ENV=development
PORT=8080

# --- Адреса ----------------------------------------------------------------
# APP_URL — публичный адрес этого сервера (Railway/Render). Нужен для Google OAuth и вебхуков.
# FRONTEND_URL — адрес сайта (GitHub Pages). Проверяется в CORS и куда возвращаем пользователя.
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# --- База данных -----------------------------------------------------------
# На Railway укажите путь на смонтированный том, например /data/shop.db
DB_PATH=./data/shop.db

# --- Сессии ----------------------------------------------------------------
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=30d

# --- Вход через Яндекс ID ---------------------------------------------------
# oauth.yandex.ru → «Создать приложение» → права «Доступ к логину, email»
# Redirect URI: {APP_URL}/api/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Вход через VK ID -------------------------------------------------------
# id.vk.ru/about/business/go/ → «Добавить приложение» → платформа Web
# Redirect URI: {APP_URL}/api/auth/vk/callback
# Уровень конфиденциальности: Конфиденциальное (обмен кода на бэкенде).
# Для конфиденциальных приложений VK требует сервисный ключ (service_token)
# и allowlist IP-адресов сервера в кабинете.
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_SERVICE_TOKEN=

# --- Вход через MAX (мессенджер) --------------------------------------------
# Официального OAuth у MAX нет (проверено 11.2026). Вход — через мини-приложение
# в MAX: business.max.ru/self → создать чат-бота (после модерации) → токен бота.
# URL мини-приложения в кабинете: https://bladadd.github.io/ikra-shop/max-auth.html
MAX_WEBAPP_TOKEN=
# Диплинк на бота/мини-приложение (виден покупателям в окне входа):
MAX_BOT_LINK=

# Почты администраторов через запятую. При старте сервер выставит им is_admin=1.
ADMIN_EMAILS=owner@example.com

# --- RollyPay --------------------------------------------------------------
# panel.rollypay.io → касса → API-ключ и signing_secret
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
# true — тестовые платежи (не списывают деньги). Для приёма реальных оплат: false
ROLLYPAY_TEST_MODE=true
ROLLYPAY_BASE_URL=https://rollypay.io

# --- Совместимость со старой админкой (GitHub Pages) ----------------------
# Токен, которым admin.html на GitHub Pages получает право сохранять каталог
# через PUT /api/admin/catalog. Если пусто — запись каталога недоступна.
ADMIN_API_TOKEN=

# --- Доставка --------------------------------------------------------------
FREE_SHIPPING_FROM=5000
DELIVERY_FEE=350