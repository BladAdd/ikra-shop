# ============================================================================
# Икра & Рыба — переменные окружения сервера
# Скопируйте в .env и заполните. Файл .env в .gitignore, в репозиторий не попадёт.
# ============================================================================

NODE_ENV=development
PORT=8080

# --- Адреса ----------------------------------------------------------------
# APP_URL — публичный адрес этого сервера (Railway/Render). Нужен для Google OAuth и вебхуков.
# FRONTEND_URL — адрес сайта (GitHub Pages). Проверяется в CORS и куда возвращаем пользователя.
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# --- База данных -----------------------------------------------------------
# На Railway укажите путь на смонтированный том, например /data/shop.db
DB_PATH=./data/shop.db

# --- Сессии ----------------------------------------------------------------
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=30d

# --- Google OAuth ----------------------------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Почты администраторов через запятую. При старте сервер выставит им is_admin=1.
ADMIN_EMAILS=owner@example.com

# --- RollyPay --------------------------------------------------------------
# panel.rollypay.io → касса → API-ключ и signing_secret
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
# true — тестовые платежи (не списывают деньги). Для приёма реальных оплат: false
ROLLYPAY_TEST_MODE=true
ROLLYPAY_BASE_URL=https://rollypay.io

# --- Совместимость со старой админкой (GitHub Pages) ----------------------
# Токен, которым admin.html на GitHub Pages получает право сохранять каталог
# через PUT /api/admin/catalog. Если пусто — запись каталога недоступна.
ADMIN_API_TOKEN=

# --- Доставка --------------------------------------------------------------
FREE_SHIPPING_FROM=5000
DELIVERY_FEE=350